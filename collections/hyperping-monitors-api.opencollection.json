          "info": {
            "name": "Delete a monitor",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.hyperping.io/v1/monitors/:monitor_uuid",
            "params": [
              {
                "name": "monitor_uuid",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the monitor."
              }
